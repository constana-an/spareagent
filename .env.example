# SpareAgent local development settings. Copy to .env; never commit .env.
# DEV_AUTH_ONLY=true is refused at startup unless APP_ENV=local.
APP_ENV=local
DEV_AUTH_ONLY=true
DATABASE_URL=postgresql+asyncpg://spareagent:spareagent@postgres:5432/spareagent
REDIS_URL=redis://redis:6379/0
# Only "mock" is implemented in Week 1. No network model calls are made.
PROVIDER_MODE=mock
# Unused in Week 1. Leave unset; never put a ChatGPT/Claude subscription token here.
OPENAI_API_KEY=
LOG_LEVEL=INFO
API_PORT=8000

# Week 4 experimental subscription sharing (invitation-only, non-commercial).
# Operator kill switches; both off by default. LIVE additionally needs a verified,
# route-covered authorization (OpenAI ticket 10766658 scope) and owner attestations.
EXPERIMENT_ENABLED=false
EXPERIMENT_LIVE_ENABLED=false
EXPERIMENT_MAX_GROUP_MEMBERS=5

# Invite-only web sessions are separate from owner-device Codex authentication.
FRIENDS_AUTH_ENABLED=false
FRIENDS_WEB_ORIGIN=http://localhost:3000
